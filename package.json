{
  "name": "dsh-minimax-voice",
  "version": "0.2.0",
  "description": "Voice cloning, text-to-speech and speech-to-text for DeepSeek Harness, powered by MiniMax · DeepSeek Harness 的 MiniMax 音色复刻 / 文本转音频 / 语音转文字插件",
  "type": "module",
  "license": "MIT",
  "author": "Sunshine334419520",
  "homepage": "https://github.com/Sunshine334419520/dsh-minimax-voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunshine334419520/dsh-minimax-voice.git"
  },
  "bugs": {
    "url": "https://github.com/Sunshine334419520/dsh-minimax-voice/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "minimax",
    "voice-clone",
    "tts",
    "text-to-speech",
    "asr",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
